{
    "name": "steadfast-courier/steadfast-laravel-package",
    "description": "A complete Laravel package for SteadFast Courier Limited",
    "keywords": [
        "SteadFast",
        "laravel",
        "courier",
        "bangladesh",
        "steadfast-laravel-package"
    ],
    "homepage": "https://github.com/steadfast-it/SteadFast-Laravel-Package",
    "license": "MIT",
    "authors": [
        {
            "name": "SteadFast",
            "email": "it@steadfast.com.bd",
            "role": "Owner"
        }
    ],
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8|^8.0",
        "illuminate/contracts": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.93"
    },
    "replace": {
        "steadfast-courier/steadfast-courier-laravel-package": "self.version"
    },
    "require-dev": {
        "larastan/larastan": "^3.14",
        "laravel/pint": "^1.32",
        "nunomaduro/collision": "^8.9.5",
        "orchestra/testbench": "^10.12|^11.3",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.1",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "SteadFast\\SteadFastCourierLaravelPackage\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SteadFast\\SteadFastCourierLaravelPackage\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": [
            "@composer run prepare",
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "@composer run build",
            "@php vendor/bin/testbench serve"
        ],
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SteadFast\\SteadFastCourierLaravelPackage\\LaravelSteadfastCourierServiceProvider"
            ],
            "aliases": {
                "SteadFastCourier": "SteadFast\\SteadFastCourierLaravelPackage\\Facades\\SteadfastCourier"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
